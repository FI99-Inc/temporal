{
  "name": "temporal-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "node --test tests/*.test.ts",
    "build": "npm run check && vite build",
    "tauri": "tauri",
    "app": "tauri dev",
    "preview:prepare": "cargo build -p temporal-app --no-default-features --features dev-tools --bin scenario-preview --locked",
    "preview": "npm run preview:prepare && npm run dev"
  },
  "dependencies": { "@tauri-apps/api": "2.11.1" },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "24.13.3",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.2.2"
  }
}
